APP_NAME="Book Registry API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Number of PHP built-in server workers used by "php artisan serve".
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (the "mysql" service). The test database "<DB_DATABASE>_testing" is created
# automatically the first time the MySQL volume is initialized.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=book_registry
DB_USERNAME=book_registry
DB_PASSWORD=secret

# The API is stateless (token auth), so sessions are never persisted.
SESSION_DRIVER=array

QUEUE_CONNECTION=redis

# Cache store, also used by the rate limiter counters.
CACHE_STORE=redis
# CACHE_PREFIX=

# Redis (the "redis" service).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# API rate limits, in requests per minute.
# API_AUTH_RATE_LIMIT applies to login (per IP + email) and register (per IP).
# API_RATE_LIMIT applies to all other API routes (per authenticated user).
API_AUTH_RATE_LIMIT=10
API_RATE_LIMIT=60

# Book list pagination: default and maximum accepted value for "per_page".
API_DEFAULT_PER_PAGE=15
API_MAX_PER_PAGE=100

# Lifetime of API tokens, in minutes (1440 = 24 hours).
SANCTUM_TOKEN_EXPIRATION=1440
